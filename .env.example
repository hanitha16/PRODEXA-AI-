# ============================================================
# PRODEXA AI — Environment Configuration Template
# ============================================================

# Platform Port & Mode
VITE_APP_NAME="PRODEXA AI"
VITE_APP_VERSION="2.4.0"
VITE_APP_ENV="production"

# AI Provider Configuration (Options: local | openai | anthropic | gemini)
VITE_AI_PROVIDER="local"
VITE_AI_MODEL="prodexa-deterministic-v2.4"
VITE_AI_API_KEY=""

# Single Sign-On / OAuth Configuration (Optional)
VITE_GOOGLE_CLIENT_ID=""
VITE_GOOGLE_CLIENT_SECRET=""
VITE_MICROSOFT_CLIENT_ID=""
VITE_MICROSOFT_TENANT_ID=""

# Backend API Endpoint (Optional if running headless)
VITE_API_BASE_URL="http://localhost:3000/api"
